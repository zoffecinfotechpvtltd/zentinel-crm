NODE_ENV=development
PORT=4000

DATABASE_URL=postgres://zoffec:zoffec_dev_local@localhost:5432/zoffec_cms

SESSION_COOKIE_NAME=zoffec_sid
SESSION_TTL_HOURS=12
SESSION_REMEMBER_TTL_DAYS=30

# used for password reset token links
APP_BASE_URL=http://localhost:5173

# SMTP is normally configured through the app's Settings screen (admin-only,
# works with any provider — Gmail, Zoho, your own mail server, whatever you
# use). These env vars are an optional fallback if you'd rather not use the
# UI; leave blank to have emails logged to the console instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
