{
  "name": "zoffec-sentinel-desktop",
  "version": "2.0.0",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "prepare-resources": "node prepare-resources.js",
    "dist": "npm run prepare-resources && electron-builder"
  },
  "author": "Zoffec Infotech Pvt. Ltd.",
  "description": "Zoffec Sentinel — internal CRM & operations platform",
  "dependencies": {
    "embedded-postgres": "18.4.0-beta.17",
    "node-pg-migrate": "^7.9.1",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.zoffecinfotech.sentinel",
    "productName": "Zoffec Sentinel",
    "directories": {
      "output": "release"
    },
    "asar": false,
    "files": [
      "main.js",
      "mode-select.html",
      "mode-select-preload.js",
      "package.json",
      "node_modules/**/*"
    ],
    "extraResources": [
      { "from": "resources/backend", "to": "backend" },
      { "from": "resources/frontend", "to": "frontend" }
    ],
    "win": {
      "target": ["nsis"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
